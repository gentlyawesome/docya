# Copy to .env and fill in. Use the "anon public" key only, NEVER the service_role key.
# Local Supabase (supabase start): URL is http://127.0.0.1:54321, keys are printed by `supabase status`.
# Hosted Supabase: Dashboard > Settings > API.
# After changing .env, restart Metro with: npx react-native start --reset-cache
SUPABASE_URL=
SUPABASE_ANON_KEY=
