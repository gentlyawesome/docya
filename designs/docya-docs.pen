              "width": 380,
              "layout": "vertical",
              "gap": 20,
              "children": [
                {
                  "type": "text",
                  "id": "E4anaD",
                  "name": "Eyebrow",
                  "fill": "$ink-muted",
                  "content": "FAQ",
                  "fontFamily": "$font-mono",
                  "fontSize": 13,
                  "fontWeight": "normal",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "ABU1r",
                  "name": "Title",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Before you join.",
                  "lineHeight": 1.1,
                  "fontFamily": "$font-display",
                  "fontSize": 48,
                  "fontWeight": "500",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "iT8au",
                  "name": "Body",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Something we have not covered? Ask us and a person will reply.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "RrZfu",
              "name": "FAQ List",
              "width": "fill_container",
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "wbDrc",
                  "name": "Question 1",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    0,
                    0,
                    32,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "wzJgg",
                      "name": "Question",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What is the pilot?",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-display",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.3
                    },
                    {
                      "type": "text",
                      "id": "SxDPE",
                      "name": "Answer",
                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": 620,
                      "content": "A free 30-day run with a small group of independent clinics. You use Docya with your real appointments and tell us what works and what does not.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "X9AG2K",
                  "name": "Question 2",
                  "width": "fill_container",
                  "stroke": "$line",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    32,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "qt1cX",
                      "name": "Question",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What happens after the 30 days?",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-display",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.3
                    },
                    {
                      "type": "text",
                      "id": "G2Oy3L",
                      "name": "Answer",
                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": 620,
                      "content": "You choose a plan or you stop. Nothing is billed during the pilot, and the prices on this page are the ones we plan to launch with.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "lZ3pB",
                  "name": "Question 3",
                  "width": "fill_container",
                  "stroke": "$line",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    32,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "SLtoN",
                      "name": "Question",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Do my patients need to install anything?",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-display",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.3
                    },
                    {
                      "type": "text",
                      "id": "M0qBr",
                      "name": "Answer",
                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": 620,
                      "content": "No. The reminder arrives as a message on the phone they already have, and they confirm by replying.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wuwIl",
                  "name": "Question 4",
                  "width": "fill_container",
                  "stroke": "$line",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    32,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "t91SjZ",
                      "name": "Question",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Do I have to change how I take bookings?",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-display",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.3
                    },
                    {
                      "type": "text",
                      "id": "iQ2xv",
                      "name": "Answer",
                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": 620,
                      "content": "No. Keep booking the way you do now and add each appointment to your Docya diary. The reminders follow from there.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Nxhe4",
                  "name": "Question 5",
                  "width": "fill_container",
                  "stroke": "$line",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    32,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "MBXhj",
                      "name": "Question",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Which clinics is this for?",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-display",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.3
                    },
                    {
                      "type": "text",
                      "id": "A86k0D",
                      "name": "Answer",
                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": 620,
                      "content": "Independent clinics and solo practitioners who manage their own bookings, with or without front-desk staff.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                }
